def load_config():
    if CONFIG_FILE.exists():
        try:
            with open(CONFIG_FILE) as f:
                cfg = json.load(f)
            return {**DEFAULT_CONFIG, **cfg}
        except Exception:
            pass
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    with open(CONFIG_FILE, 'w') as f:
        json.dump(DEFAULT_CONFIG, f, indent=2)
    return dict(DEFAULT_CONFIG)

def load_stats():
    try:
        if STATS_FILE.exists():
            with open(STATS_FILE) as f:
                return json.load(f)
    except Exception:
        pass
    return {}

def stats_summary(stats):
    today = datetime.now().date().isoformat()
    labels = STRINGS[LANG]['labels']
    parts = []
    for modo in ('visual', 'activo', 'almuerzo', 'dormir', 'agua'):
        if modo in stats:
            s = stats[modo]
            t = s['today'] if s.get('date') == today else 0
            tot = s['total']
            if t > 0 or tot > 0:
                parts.append(f"{t} {labels[modo]} (total {tot})")
    return parts

def weekly_summary(stats):
    today = datetime.now().date()
    week_start = today - timedelta(days=today.weekday())
    totals = {}
    for i in range(7):
        day = (week_start + timedelta(days=i)).isoformat()
        if day in stats.get('history', {}):
            for modo, count in stats['history'][day].items():
                totals[modo] = totals.get(modo, 0) + count
    labels = STRINGS[LANG]['labels']
    parts = []
    for modo, count in sorted(totals.items(), key=lambda x: -x[1]):
        if modo in labels and count > 0:
            parts.append(f"{count} {labels[modo]}")
    return parts

def play_sound():
    try:
        subprocess.Popen(
            ['ffplay', '-nodisp', '-autoexit', '-f', 'lavfi', '-i',
             'sine=frequency=523:duration=0.3,volume=0.15'],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        )
    except FileNotFoundError:
        try:
            import winsound
            winsound.Beep(523, 300)
        except (ImportError, OSError):
            pass

def play_music(url, duration):
    if not url:
        return None
    for cmd in [
        ['ffplay', '-nodisp', '-autoexit', '-t', str(duration), url],
        ['mpv', '--no-video', '--length=' + str(duration), url],
    ]:
        try:
            return subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except FileNotFoundError:
            continue
    return None

def stop_music(proc):
    if proc is None:
        return
    try:
        proc.terminate()
        proc.wait(timeout=2)
    except Exception:
        try:
            proc.kill()
        except Exception:
            pass

def fetch_weather(city=""):
    try:
        # weather_city sale de la config del usuario: se escapa para que no pueda
        # añadir parámetros ni saltar de ruta dentro de la URL.
        url = f"https://wttr.in/{urllib.parse.quote(city, safe='')}?format=%t+%C&lang={LANG}"
        req = urllib.request.Request(url, headers={'User-Agent': 'curl/7.0'})
        resp = urllib.request.urlopen(req, timeout=5)
        return resp.read().decode().strip()
    except Exception:
        return None

def get_weather(city=""):
    try:
        if WEATHER_CACHE.exists():
            data = json.loads(WEATHER_CACHE.read_text())
            if time.time() - data.get('time', 0) < 1800:
                return data.get('text')
    except Exception:
        pass
    text = fetch_weather(city)
    if text:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        WEATHER_CACHE.write_text(json.dumps({'text': text, 'time': time.time()}))
    return text

def is_snoozed():
    try:
        if SNOOZE_FILE.exists():
            snooze_until = float(SNOOZE_FILE.read_text().strip())
            if time.time() < snooze_until:
                return True
            SNOOZE_FILE.unlink(missing_ok=True)
    except Exception:
        pass
    return False

def find_pantalla():
    script_dir = Path(__file__).resolve().parent
    candidates = [
        script_dir / 'pantalla-descanso',
        script_dir / 'pantalla-descanso.exe',
        Path.home() / '.local' / 'bin' / 'pantalla-descanso',
        Path.home() / '.local' / 'bin' / 'pantalla-descanso.exe',
    ]
    for c in candidates:
        if c.exists():
            return str(c)
    return str(script_dir / 'pantalla-descanso')

def find_sound(name):
    script_dir = Path(__file__).resolve().parent
    candidates = [
        script_dir / 'sounds' / f'{name}.mp3',
        Path.home() / '.local' / 'bin' / 'sounds' / f'{name}.mp3',
    ]
    for c in candidates:
        if c.exists():
            return str(c)
    return None

def resolve_ambient(choice):
    if choice in (None, '', 'ninguno'):
        return None
    if choice == 'aleatorio':
        choice = random.choice(AMBIENT_SOUNDS)
    return find_sound(choice)

def find_widget():
    script_dir = Path(__file__).resolve().parent
    candidates = [
        script_dir / 'descanso-widget',
        script_dir / 'descanso-widget.exe',
        Path.home() / '.local' / 'bin' / 'descanso-widget',
        Path.home() / '.local' / 'bin' / 'descanso-widget.exe',
    ]
    for c in candidates:
        if c.exists():
            return str(c)
    return None

def launch_break(mode, duration, animal, weather):
    script = find_pantalla()
    args = [sys.executable, script, str(duration), mode, animal]
    if weather:
        args.append(weather)
    try:
        subprocess.run(args)
    except Exception as e:
        print(f"Error: {mode} -> {e}")

def parse_time(t_str, day):
    h, m = t_str.split(':')
    return datetime(day.year, day.month, day.day, int(h), int(m))

def write_state(next_visual, next_active, next_water, vi, ai, wi, config, hoy, now):
    lunch = parse_time(config['lunch_time'], hoy)
    if lunch < now:
        lunch += timedelta(days=1)
    sleep = parse_time(config['sleep_time'], hoy)
    if sleep < now:
        sleep += timedelta(days=1)
    try:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        with open(STATE_FILE, 'w') as f:
            json.dump({
                'next_visual': next_visual,
                'next_active': next_active,
                'next_water': next_water,
                'visual_interval': vi,
                'active_interval': ai,
                'water_interval': wi,
                'next_lunch': lunch.timestamp(),
                'next_sleep': sleep.timestamp(),
                'snoozed_until': float(SNOOZE_FILE.read_text().strip()) if SNOOZE_FILE.exists() else None,
                'theme': config.get('theme', 'dark'),
                'updated': time.time(),
            }, f)
    except Exception:
        pass

def print_update(show_weekly=False):
    stats = load_stats()
    for p in stats_summary(stats):
        print(f"  {p}")
    if show_weekly:
        wparts = weekly_summary(stats)
        if wparts:
            print(f"{STRINGS[LANG]['week_prefix']}{'  ·  '.join(wparts)}")
    return stats

def trigger_break(mode, duration, animal, weather, use_sound, music_url=None, show_weekly=False):
    if use_sound:
        play_sound()
    mp = play_music(music_url, duration)
    launch_break(mode, duration, animal, weather)
    stop_music(mp)
    return print_update(show_weekly)

def main():
    config = load_config()
    global LANG
    lang_cfg = config.get('language', 'auto')
    if lang_cfg in ('es', 'en'):
        LANG = lang_cfg
    S = STRINGS[LANG]
    vi = config['visual_interval_min'] * 60
    ai = config['active_interval_min'] * 60
    wi = config['water_interval_min'] * 60
    use_sound = config.get('sound', True)

    next_visual = time.time()
    next_active = time.time() + ai
    next_water = time.time() + wi
    last_lunch_date = None
    last_sleep_date = None
    last_tick = time.time()

    animal = config['animal']
    ambient = config.get('ambient_sound', 'aleatorio')
    weather_city = config.get('weather_city', '')

    weather = get_weather(weather_city) if weather_city else None
    next_weather_check = time.time() + 1800

    print(S['banner_title'])
    print(S['visual_line'].format(mn=config['visual_interval_min'], sec=config['visual_duration_sec']))
    print(S['active_line'].format(mn=config['active_interval_min'], sec=config['active_duration_sec']))
    print(S['water_line'].format(mn=config['water_interval_min'], sec=config['water_duration_sec']))
    print(S['lunch_line'].format(t=config['lunch_time']))
    print(S['sleep_line'].format(t=config['sleep_time']))
    print(S['animal_line'].format(a=animal))
    print(S['theme_line'].format(t=config.get('theme', 'dark')))
    print(S['music_line'].format(v=S['no'] if ambient in (None, '', 'ninguno') else ambient))
    print(S['sound_line'].format(v=S['yes'] if use_sound else S['no']))
    if weather:
        print(S['weather_line'].format(w=weather))
    stats = load_stats()
    parts = stats_summary(stats)
    if parts:
        print(S['stats_header'])
        for p in parts:
            print(f"  {p}")
    wparts = weekly_summary(stats)
    if wparts:
        print(f"{S['week_prefix']}{'  ·  '.join(wparts)}")
    print(S['footer_bar'])

    if config.get('widget', True):
        widget = find_widget()
        if widget:
            try:
                subprocess.Popen([sys.executable, widget])
            except Exception:
                pass

    while True:
        now = datetime.now()
        hoy = now.date()
        now_t = time.time()
        # ponytail: si el proceso estuvo congelado (lid closed/suspend),
        # reiniciamos los timers en vez de disparar todo lo acumulado.
        if now_t - last_tick > 30:
            next_visual = now_t + vi
            next_active = now_t + ai
            next_water = now_t + wi
        last_tick = now_t

        write_state(next_visual, next_active, next_water, vi, ai, wi, config, hoy, now)

        if weather_city and time.time() >= next_weather_check:
            weather = get_weather(weather_city)
            next_weather_check = time.time() + 1800

        if last_lunch_date != hoy:
            lunch = parse_time(config['lunch_time'], hoy)
            if lunch <= now <= lunch + timedelta(minutes=30):
                print(f"[{now.strftime('%H:%M')}] {S['mode_lunch']}")
                trigger_break('almuerzo', 0, animal, weather, use_sound, show_weekly=True)
                last_lunch_date = hoy

        if last_sleep_date != hoy:
            sleep_t = parse_time(config['sleep_time'], hoy)
            if sleep_t <= now <= sleep_t + timedelta(minutes=30):
                print(f"[{now.strftime('%H:%M')}] {S['mode_sleep']}")
                trigger_break('dormir', 0, animal, weather, use_sound, show_weekly=True)
                last_sleep_date = hoy

        if not is_snoozed():
            if time.time() >= next_water:
                print(f"[{now.strftime('%H:%M')}] {S['mode_water']}")
                trigger_break('agua', config['water_duration_sec'], animal, weather, use_sound)
                next_water = time.time() + wi

            if time.time() >= next_active:
                print(f"[{now.strftime('%H:%M')}] {S['mode_active']}")
                trigger_break('activo', config['active_duration_sec'], animal, weather, use_sound,
                               music_url=resolve_ambient(ambient), show_weekly=True)
                next_active = time.time() + ai
                next_visual = time.time() + vi

            if time.time() >= next_visual:
                print(f"[{now.strftime('%H:%M')}] {S['mode_visual']}")
                trigger_break('visual', config['visual_duration_sec'], animal, weather, use_sound,
                               music_url=resolve_ambient(ambient))
                next_visual = time.time() + vi

        time.sleep(5)

if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        print(f"\n{STRINGS[LANG]['stopped']}")
