def format_date(dt):
    wd = _WEEKDAYS[LANG][dt.weekday()]
    mo = _MONTHS[LANG][dt.month - 1]
    if LANG == 'es':
        return f"{wd}, {dt.day} de {mo} de {dt.year}"
    return f"{wd}, {mo} {dt.day}, {dt.year}"

