# la cola sube poco a poco con curva: "(" es la punta, "\" la une al cuerpo.
# DOWN: recta a ras del cuerpo. RISING: punta sube a fila 6. UP: punta arriba
# con "\" curvando hacia los "===".
_DOG_TAIL_DOWN = ("      /    |", "     /     |", "(===/___) ||")
_DOG_TAIL_RISING = ("      /    |", "(    /     |", " ===/___) ||")
_DOG_TAIL_UP = ("(     /    |", " \\   /     |", " ===/___) ||")

def _dog_frame(eyes, tail):
    r5, r6, r7 = tail
    return "\n".join([_DOG_EARS, eyes, _DOG_ROW2, _DOG_ROW3, _DOG_ROW4,
                       r5, r6, r7])

