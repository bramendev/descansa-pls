class PantallaDescanso:
    def __init__(self):
        self.root = tk.Tk()
        self.root.title(T['title_txt'])
        self.root.configure(bg=T['bg'])

        self._w = self.root.winfo_screenwidth()
        self._h = self.root.winfo_screenheight()
        try:
            self.root.attributes('-fullscreen', True)
        except Exception:
            self.root.overrideredirect(True)
            self.root.geometry(f"{self._w}x{self._h}+0+0")
        try:
            self.root.attributes('-topmost', True)
        except Exception:
            pass

        self.tiempo_restante = SEGUNDOS if TIENE_TIMER else 0
        self.inicio = time.monotonic()
        self.frame_idx = 0
        self.stats = load_stats()
        self.stats_updated = False

        self.style = ttk.Style()
        self.style.theme_use('clam')
        self.style.configure("custom.Horizontal.TProgressbar",
            troughcolor=T['ptrack'], background=T['pfill'],
            bordercolor=T['bg'], lightcolor=T['pfill'], darkcolor=T['pfill'])

        self._build_ui()
        self._build_close_x()
        self._bind_keys()

        self.root.after(100, self._tick)
        self.root.after(200, self._grab_focus)
        if TIENE_TIMER:
            self.root.after(500, self._animar)
            self.root.after(100, self._timer_tick)

    def _build_ui(self):
        self.root.grid_columnconfigure(0, weight=1)
        self.root.grid_rowconfigure(0, weight=1)

        f = tk.Frame(self.root, bg=T['bg'])
        f.grid(row=0, column=0)

        self.label_clock = tk.Label(f, bg=T['bg'], fg=T['clock'],
            font=(SANS, 80, 'bold'))
        self.label_clock.pack(pady=(40, 0))

        self.label_date = tk.Label(f, bg=T['bg'], fg=T['date'],
            font=(SANS, 16))
        self.label_date.pack()

        if WEATHER:
            tk.Label(f, bg=T['bg'], fg=T['date'], font=(SANS, 14),
                text=WEATHER).pack()

        if TIENE_TIMER:
            if SPRITE_PNGS:
                self.sprite_imgs = [tk.PhotoImage(file=str(p)).zoom(3)
                                    for p in SPRITE_PNGS]
                self.label_animal = tk.Label(f, image=self.sprite_imgs[0],
                    bg=T['bg'], bd=0)
                self.label_animal.pack(pady=(20, 0))
            else:
                self.animal_font = font.Font(family=MONO, size=14)
                n_lines = len(FRAMES[0].split('\n'))
                line_h = self.animal_font.metrics('linespace')
                canvas_w = max(self.animal_font.measure(l)
                               for fr in FRAMES for l in fr.split('\n')) + 10
                canvas_h = line_h * n_lines + 10
                self.canvas_animal = tk.Canvas(f, bg=T['bg'], highlightthickness=0,
                    width=canvas_w, height=canvas_h)
                self.canvas_animal.pack(pady=(20,0))
                self._render_animal_frame(0)

            self.label_timer = tk.Label(f, bg=T['bg'], fg=T['timer'],
                font=(SANS, 22))
            self.label_timer.pack(pady=(16, 0))

            self.progress = ttk.Progressbar(f, style="custom.Horizontal.TProgressbar",
                length=380, mode='determinate')
            self.progress.pack(pady=(10, 8))

            pool = _CURIOSIDADES + _MOTIVACIONALES if MODO == 'visual' else _EJERCICIOS + _MOTIVACIONALES
            tk.Label(f, bg=T['bg'], fg=T['info'], font=(SANS, 16, 'italic'),
                wraplength=600, text=random.choice(pool)).pack(pady=(16, 0))
        else:
            icon_lines = BOWL if MODO == 'almuerzo' else MOON if MODO == 'dormir' else WATER
            icon_text = '\n'.join(l.center(max(len(r) for r in icon_lines)) for l in icon_lines)
            tk.Label(f, bg=T['bg'], fg=T['animal'],
                font=(MONO, 16), text=icon_text, justify='center').pack(pady=(20, 0))

            tk.Label(f, bg=T['bg'], fg=T['title'],
                font=(SANS, 36, 'bold'), text=T['title_txt']).pack(pady=(20, 0))

            pool = _COMIDAS if MODO == 'almuerzo' else _DORMIR_TIPS if MODO == 'dormir' else _AGUA_MSGS
            tk.Label(f, bg=T['bg'], fg=T['text'],
                font=(SANS, 20), wraplength=600, text=random.choice(pool)).pack(pady=(12, 0))

            foot = UI['foot_agua'] if MODO == 'agua' else UI['foot_otro']
            tk.Label(f, bg=T['bg'], fg=T['info'],
                font=(SANS, 14, 'italic'), text=foot).pack(pady=(12, 0))

        tk.Label(f, bg=T['bg'], fg=T['date'], font=(SANS, 13),
            text=get_stats_line(self.stats)).pack(pady=(12, 0))

        weekly_line = get_weekly_line(self.stats)
        if weekly_line:
            tk.Label(f, bg=T['bg'], fg=T['date'],
                font=(SANS, 12), text=weekly_line).pack()

        if not TIENE_TIMER:
            auto_ms = 10000 if MODO == 'agua' else 600000
            self.root.after(auto_ms, self.do_skip)

        btn_text = UI['btn_close'] if not TIENE_TIMER else UI['btn_unlock']
        self.btn = tk.Button(f, text=btn_text,
            font=(SANS, 16, 'bold'), bg=T['btn'], fg='white',
            activebackground=T['bord'], activeforeground='white',
            bd=2, relief='solid', highlightbackground=T['bord'],
            cursor='hand2', padx=40, pady=12)
        self.btn.config(command=self.do_skip)
        if TIENE_TIMER:
            self.btn.pack_forget()
        else:
            self.btn.pack(pady=(16, 0))

        hint = UI['hint_timer'] if TIENE_TIMER else UI['hint_notimer']
        tk.Label(f, bg=T['bg'], fg=T['date'],
            font=(SANS, 11), text=hint).pack(pady=(8, 0))

    def _build_close_x(self):
        self.btn_x = tk.Button(self.root, text="✕",
            font=(SANS, 16, 'bold'), bg=T['bg'], fg=T['date'],
            activebackground=T['bord'], activeforeground='white',
            bd=0, relief='flat', cursor='hand2', padx=12, pady=4,
            command=self.do_skip)
        self.btn_x.place(x=self._w - 50, y=10)
        if TIENE_TIMER:
            self.btn_x.config(state='disabled', fg=T['ptrack'])

    def _grab_focus(self):
        self.root.lift()
        self.root.focus_force()

    def _bind_keys(self):
        self.root.bind('<Key-space>', lambda e: self.do_skip())
        self.root.bind('<Key-z>', lambda e: self.do_snooze())
        self.root.bind('<Key-Z>', lambda e: self.do_snooze())
        self.root.bind('<Escape>', lambda e: self.do_skip() if (not TIENE_TIMER or self.tiempo_restante <= 0) else None)
        self.root.bind('<Return>', lambda e: self.do_skip() if (self.btn.winfo_viewable()) else None)
        self.root.bind('<KP_Enter>', lambda e: self.do_skip() if (self.btn.winfo_viewable()) else None)

    def _tick(self):
        ahora = time.localtime()
        self.label_clock.config(text=time.strftime("%H:%M", ahora))
        self.label_date.config(text=format_date(datetime.now()))
        self.root.after(1000, self._tick)

    def _render_animal_frame(self, idx):
        if SPRITE_PNGS:
            self.label_animal.config(image=self.sprite_imgs[idx % len(self.sprite_imgs)])
            return
        self.canvas_animal.delete("all")
        self.canvas_animal.create_text(
            self.canvas_animal.winfo_reqwidth() // 2,
            self.canvas_animal.winfo_reqheight() // 2,
            text=FRAMES[idx], font=self.animal_font, fill=T['animal'],
            anchor='center', justify='left')

    def _animar(self):
        n = len(self.sprite_imgs) if SPRITE_PNGS else len(FRAMES)
        self.frame_idx = (self.frame_idx + 1) % n
        self._render_animal_frame(self.frame_idx)
        self.root.after(500, self._animar)

    def _timer_tick(self):
        transcurrido = time.monotonic() - self.inicio
        restante = max(0, SEGUNDOS - transcurrido)
        self.tiempo_restante = int(restante)
        pct = min(transcurrido / SEGUNDOS, 1.0) * 100
        self.progress['value'] = pct
        self.label_timer.config(text=UI['timer_text'].format(s=int(restante)))

        if restante <= 0:
            self.progress['value'] = 100
            self.label_timer.config(text=UI['timer_done'])
            self.btn.pack(pady=(16, 0))
            self.btn_x.config(state='normal', fg=T['date'])
            return

        self.root.after(100, self._timer_tick)

    def _cleanup(self):
        if not self.stats_updated:
            increment_stat(MODO)
            self.stats_updated = True

    def do_snooze(self):
        write_snooze()
        self._cleanup()
        self.root.destroy()

    def do_skip(self):
        self._cleanup()
        self.root.destroy()


if __name__ == "__main__":
    app = PantallaDescanso()
    app.root.mainloop()
