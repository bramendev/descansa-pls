# "Noodles" - classic ASCII dog (asciiart.eu/animals/dogs), used verbatim.
_DOG_EARS = "       /^-^\\"
_DOG_ROW2 = "     /   Y   \\"
_DOG_ROW3 = "     V \\ v / V"
_DOG_ROW4 = "       / - \\"
_DOG_ROW7 = " ===/___) ||"
