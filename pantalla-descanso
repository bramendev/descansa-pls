    _dog_frame(_DOG_EYES_OPEN, _DOG_TAIL_RISING),
    _dog_frame(_DOG_EYES_OPEN, _DOG_TAIL_UP),
    _dog_frame(_DOG_EYES_BLINK, _DOG_TAIL_UP),
    _dog_frame(_DOG_EYES_OPEN, _DOG_TAIL_UP),
    _dog_frame(_DOG_EYES_OPEN, _DOG_TAIL_RISING),
    _dog_frame(_DOG_EYES_OPEN, _DOG_TAIL_DOWN),
